{
  "name": "alibi-exe",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply alibi-exe --local",
    "db:migrate:remote": "wrangler d1 migrations apply alibi-exe --remote",
    "cf:typegen": "wrangler types cloudflare-bindings.d.ts --env-interface WorkerBindings --include-runtime=false --strict-vars=false"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "@radix-ui/react-dialog": "1.3.1",
    "clsx": "2.1.1",
    "driver.js": "^1.10.2",
    "lucide-react": "1.62.0",
    "motion": "14.7.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261027.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "wrangler": "4.153.0"
  }
}
